{
  "name": "global-power-gis-scripts",
  "version": "0.0.0",
  "private": true,
  "description": "构建期工具链：OSM 取数 / GeoJSON 合并 / PMTiles 切片。依赖只装在 scripts/ 下，主项目前端与 src-tauri 完全不依赖它们。",
  "type": "module",
  "scripts": {
    "geojson": "node prepare_osm_geojson.mjs",
    "pmtiles": "node build_pmtiles.mjs",
    "basemap": "node fetch_basemap.mjs",
    "glyphs": "node fetch_glyphs.mjs"
  },
  "devDependencies": {
    "geojson-vt": "5.0.2",
    "vt-pbf": "3.1.3"
  }
}
